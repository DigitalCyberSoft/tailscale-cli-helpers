#!/usr/bin/env bash
#
# trsync - Tailscale rsync helper
# rsync with Tailscale hostname resolution
#

# Detect shell and set compatibility options
if [ -n "$ZSH_VERSION" ]; then
    emulate -L bash
    setopt BASH_REMATCH
    setopt KSH_ARRAYS
fi

# Enable safety features
set -o pipefail
IFS=$' \t\n'

# Check dependencies
if ! command -v rsync >/dev/null 2>&1; then
    echo "Error: rsync is required but not installed" >&2
    exit 1
fi

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source common utilities
if [[ -f "$SCRIPT_DIR/../lib/common.sh" ]]; then
    source "$SCRIPT_DIR/../lib/common.sh"
elif [[ -f "$SCRIPT_DIR/../share/tailscale-cli-helpers/lib/common.sh" ]]; then
    source "$SCRIPT_DIR/../share/tailscale-cli-helpers/lib/common.sh"
elif [[ -f "$HOME/.local/share/tailscale-cli-helpers/lib/common.sh" ]]; then
    source "$HOME/.local/share/tailscale-cli-helpers/lib/common.sh"
elif [[ -f "/usr/share/tailscale-cli-helpers/lib/common.sh" ]]; then
    source "/usr/share/tailscale-cli-helpers/lib/common.sh"
elif [[ -f "/usr/local/share/tailscale-cli-helpers/lib/common.sh" ]]; then
    source "/usr/local/share/tailscale-cli-helpers/lib/common.sh"
fi

# Source the shared resolver library
if [[ -f "$SCRIPT_DIR/../lib/tailscale-resolver.sh" ]]; then
    source "$SCRIPT_DIR/../lib/tailscale-resolver.sh"
elif [[ -f "$SCRIPT_DIR/../share/tailscale-cli-helpers/lib/tailscale-resolver.sh" ]]; then
    source "$SCRIPT_DIR/../share/tailscale-cli-helpers/lib/tailscale-resolver.sh"
elif [[ -f "$HOME/.local/share/tailscale-cli-helpers/lib/tailscale-resolver.sh" ]]; then
    source "$HOME/.local/share/tailscale-cli-helpers/lib/tailscale-resolver.sh"
elif [[ -f "/usr/share/tailscale-cli-helpers/lib/tailscale-resolver.sh" ]]; then
    source "/usr/share/tailscale-cli-helpers/lib/tailscale-resolver.sh"
elif [[ -f "/usr/local/share/tailscale-cli-helpers/lib/tailscale-resolver.sh" ]]; then
    source "/usr/local/share/tailscale-cli-helpers/lib/tailscale-resolver.sh"
else
    echo "Error: Cannot find tailscale-resolver.sh library" >&2
    exit 1
fi

# Show help
show_trsync_help() {
    echo "trsync - rsync with Tailscale hostname resolution v$TAILSCALE_CLI_HELPERS_VERSION"
    echo ""
    echo "Usage:"
    echo "  trsync [rsync_options] source destination"
    echo ""
    echo "Options:"
    echo "  -h, --help       Show this help message"
    echo "  -V, --version    Show version information"
    echo ""
    echo "rsync file synchronization with automatic Tailscale hostname resolution."
    echo "Resolves hostnames in remote file specifications (host:path) and jump"
    echo "hosts in the remote shell (-e \"ssh -J host\") or given ssh-style (-J host)."
}

# Resolve the jump hosts in an rsync remote shell command ("ssh -J host")
resolve_rsh_jump_hosts() {
    local rsh="$1"
    local words=()
    read -r -a words <<< "$rsh"
    if resolve_jump_args "" "${words[@]}"; then
        echo "${JUMP_ARGS[*]}"
    else
        echo "$rsh"
    fi
}

# Main function
main() {
    # Handle version and help early
    for arg in "$@"; do
        case "$arg" in
            --version|-V)
                echo "trsync $TAILSCALE_CLI_HELPERS_VERSION"
                exit 0
                ;;
            --help|-h)
                show_trsync_help
                exit 0
                ;;
        esac
    done
    
    if [[ $# -eq 0 ]]; then
        show_trsync_help
        exit 1
    fi
    
    local resolved_args=()
    local verbose=false
    
    # Check for -v flag
    for arg in "$@"; do
        if [[ "$arg" == "-v" ]] || [[ "$arg" == "-"*"v"* ]]; then
            verbose=true
            break
        fi
    done
    
    local rsh_next=false
    local rsh_index=-1
    local jump_spec=""
    local arg
    while [[ $# -gt 0 ]]; do
        arg="$1"
        shift
        if [[ "$rsh_next" == "true" ]]; then
            # Remote shell command given after -e / --rsh
            rsh_index=${#resolved_args[@]}
            resolved_args+=("$(resolve_rsh_jump_hosts "$arg")")
            rsh_next=false
        elif [[ "$arg" == "-J" ]] && [[ $# -gt 0 ]] && [[ "$1" != -* ]] && \
             [[ "$1" != *[/:]* ]] && [[ ! -e "$1" ]] && [[ ! -L "$1" ]]; then
            # ssh-style -J <jumphost>. rsync's own -J (--omit-link-times) takes
            # no argument, so the word after it would be a source path; one with
            # no / or : that does not exist locally can only be a jump host.
            jump_spec="${jump_spec:+$jump_spec,}$1"
            shift
        elif [[ "$arg" == "--rsh" ]] || [[ "$arg" =~ ^-[a-zA-Z0-9]*e$ ]]; then
            # -e on its own or ending a bundle (-avze): the command follows
            resolved_args+=("$arg")
            rsh_next=true
        elif [[ "$arg" == "--rsh="* ]]; then
            rsh_index=${#resolved_args[@]}
            resolved_args+=("--rsh=$(resolve_rsh_jump_hosts "${arg#--rsh=}")")
        elif [[ "$arg" == "-e"?* ]]; then
            rsh_index=${#resolved_args[@]}
            resolved_args+=("-e$(resolve_rsh_jump_hosts "${arg#-e}")")
        elif [[ "$arg" == *":"* ]] && [[ "$arg" != "-"* ]] && [[ "$arg" != *"::"* ]]; then
            # This looks like a remote host:path spec (but not rsync daemon :: syntax)
            local host_part="${arg%%:*}"
            local path_part="${arg#*:}"

            # Resolve hostname interactively, showing which arg we're resolving
            local resolved_host
            resolved_host=$(resolve_host_interactive "$host_part" "$arg")
            if [[ $? -eq 0 ]]; then
                resolved_args+=("${resolved_host}:${path_part}")
            else
                # Keep original if not resolvable
                resolved_args+=("$arg")
            fi
        else
            # Keep argument as-is
            resolved_args+=("$arg")
        fi
    done

    # Hand an ssh-style -J jump host to rsync through the remote shell
    if [[ -n "$jump_spec" ]]; then
        jump_spec=$(resolve_jump_hosts "$jump_spec" "")
        if [[ $rsh_index -ge 0 ]]; then
            resolved_args[$rsh_index]="${resolved_args[$rsh_index]} -J $jump_spec"
        else
            resolved_args=(-e "${RSYNC_RSH:-ssh} -J $jump_spec" "${resolved_args[@]}")
        fi
    fi

    # Execute rsync with resolved arguments
    exec rsync "${resolved_args[@]}"
}

# Run main function
main "$@"